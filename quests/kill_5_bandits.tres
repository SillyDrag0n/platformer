[resource]
script = ExtResource("1_quest")
id = "kill_5_bandits"
title = "Bandit Trouble"
description = "Kill 5 bandits to make the roads safer."
offer_dialogue = Array[String](["Bandits have been raiding the trade routes outside town.", "Thin their numbers - bring me word that 5 of them are dealt with - and I'll make it worth your while."])
